{
  "color": {
    "$type": "color",
    "romanesco": { "$value": "#4f7a28", "$description": "The brand's green: the logo and primary buttons." },
    "lime": { "$value": "#d4f06b", "$description": "What's selected: a chosen box, a picked day." },
    "ink": { "$value": "#1f1a17" },
    "ink-3": { "$value": "#6e6560", "$description": "Secondary text." },
    "cream": { "$value": "#fbf7ef", "$description": "Pages." },
    "oat": { "$value": "#f1ebdf", "$description": "Raised surfaces: cards, secondary buttons." },
    "beet": { "$value": "#9c1f4f", "$description": "Offers, and the Christmas boxes." },
    "warning": { "$value": "#a15c07", "$description": "Late, nearly full, about to expire." },
    "warning-surface": { "$value": "#fdf0d5" },
    "danger": { "$value": "#b3261e", "$description": "Errors and destructive actions only." }
  },
  "space": {
    "$type": "dimension",
    "xs": { "$value": "4px" },
    "sm": { "$value": "8px" },
    "md": { "$value": "12px" },
    "lg": { "$value": "16px" },
    "xl": { "$value": "24px" }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": "6px" },
    "md": { "$value": "12px" },
    "card": { "$value": "20px" }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "text": { "$value": ["Inter", "system-ui", "sans-serif"] }
    }
  }
}
