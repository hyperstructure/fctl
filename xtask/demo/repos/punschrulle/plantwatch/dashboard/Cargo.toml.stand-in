[package]
name = "plantwatch-dashboard"
version = "0.6.0"
edition = "2024"

[dependencies]
anyhow = "1"
axum = "0.8"
rumqttc = "0.25"
rusqlite = { version = "0.37", features = ["bundled"] }
serde = { version = "1", features = ["derive"] }
serde_json = "1"
tokio = { version = "1", features = ["full"] }
